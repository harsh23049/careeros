{
    "manifest_version": 3,

    "name": "CareerOS",

    "version": "1.0.0",

    "description": "CareerOS browser extension for assisting with job applications.",

    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ],

    "host_permissions": [
        "http://localhost:8000/*"
    ],

    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "CareerOS"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/content.js"
            ],
            "run_at": "document_idle"
        }
    ],

    "background": {
        "service_worker": "background/index.js"
    }
}