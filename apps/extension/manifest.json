{
    "manifest_version": 3,
    "name": "CareerOS",
    "version": "1.0.0",
    "description": "Save and manage job applications with CareerOS.",

    "permissions": [
        "activeTab",
        "storage"
    ],

    "host_permissions": [
        "http://localhost:8000/*"
    ],

    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "CareerOS"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/content.js"
            ]
        }
    ],

    "background": {
        "service_worker": "background/background.js"
    }
}